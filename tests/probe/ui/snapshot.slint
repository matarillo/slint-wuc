import { TestCase as ImagesAlignmentCase } from "../../../reference/slint-1.19.0/tests/screenshots/cases/image/images-alignment.slint";
import { TestCase as BackdropBlurCase } from "../../../reference/slint-1.19.0/tests/screenshots/cases/basic/backdrop-blur.slint";

export component Images inherits ImagesCase { }
export component BorderImage inherits BorderImageCase { }
export component ImageRepeatColorize inherits ImageRepeatColorizeCase { }
export component ImagesAlignment inherits ImagesAlignmentCase { }
export component BackdropBlur inherits BackdropBlurCase { }
