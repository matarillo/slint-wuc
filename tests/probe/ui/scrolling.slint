// A Flickable whose content is taller than it: the viewport moves, the Flickable clips.
export component Scrolling inherits Window {
    width: 120px;
    height: 120px;
    background: #000000;

    in-out property <length> offset: 0px;

    Flickable {
        x: 10px;
        y: 10px;
        width: 100px;
        height: 100px;
        content-height: 300px;
        content-y <=> root.offset;

        Rectangle {
            y: 0px;
            height: 100px;
            background: #ff0000;
        }

        Rectangle {
            y: 100px;
            height: 100px;
            background: #00ff00;
        }

        Rectangle {
            y: 200px;
            height: 100px;
            background: #0000ff;
        }
    }
}
