// Structure that changes at run time: conditionals, z order, and repeaters over a model.
export component Structure inherits Window {
    width: 200px;
    height: 100px;
    background: #000000;

    in property <bool> show-a: true;
    in property <bool> show-group;
    in property <float> z-red;
    in property <[color]> colors: [#110000, #220000, #330000];

    // Stacked at the same place: the dump order shows the z order.
    Rectangle {
        x: 0px;
        y: 0px;
        width: 10px;
        height: 10px;
        background: #ff0000;
        z: root.z-red;
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: 10px;
        height: 10px;
        background: #00ff00;
    }

    if root.show-a: Rectangle {
        x: 20px;
        y: 0px;
        width: 10px;
        height: 10px;
        background: #aaaaaa;
    }

    for c[i] in root.colors: Rectangle {
        x: 40px + i * 10px;
        y: 20px;
        width: 10px;
        height: 10px;
        background: c;
    }

    if root.show-group: Rectangle {
        x: 0px;
        y: 50px;
        width: 200px;
        height: 50px;
        background: #0000ff;

        for i in 2: Rectangle {
            x: i * 20px;
            y: 0px;
            width: 10px;
            height: 10px;
            background: #ffffff;
        }
    }

    // Last in the tree, so a reorder above can't hide behind it.
    Rectangle {
        x: 190px;
        y: 90px;
        width: 10px;
        height: 10px;
        background: #ffff00;
    }
}
