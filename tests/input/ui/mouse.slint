// A touch area in the top left corner, which records what reaches it,
// and a window move area in the bottom right corner.
export component MouseTest inherits Window {
    width: 200px;
    height: 200px;
    out property <bool> pressed: area.pressed;
    out property <bool> hover: area.has-hover;
    out property <length> mouse-x: area.mouse-x;
    out property <length> mouse-y: area.mouse-y;
    in-out property <int> clicks;
    in-out property <string> buttons;
    in-out property <length> scroll-x;
    in-out property <length> scroll-y;

    area := TouchArea {
        x: 0;
        y: 0;
        width: 100px;
        height: 100px;
        mouse-cursor: pointer;
        clicked => {
            root.clicks += 1;
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.buttons += event.button == PointerEventButton.left ? "left "
                    : event.button == PointerEventButton.right ? "right "
                    : event.button == PointerEventButton.middle ? "middle "
                    : event.button == PointerEventButton.back ? "back "
                    : event.button == PointerEventButton.forward ? "forward " : "other ";
            }
        }
        scroll-event(event) => {
            root.scroll-x += event.delta-x;
            root.scroll-y += event.delta-y;
            accept
        }
    }

    WindowMoveArea {
        x: 100px;
        y: 100px;
        width: 100px;
        height: 100px;
    }
}
